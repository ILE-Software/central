[global]
type=global
user_agent=Central-SIP
endpoint_identifier_order=ip,username

[netgsm-udp]
type=transport
protocol=udp
bind=0.0.0.0:5060

[openai-tls]
type=transport
protocol=tls
bind=0.0.0.0:5061
method=tlsv1_2
verify_server=yes
verify_client=no

[netgsm-auth]
type=auth
auth_type=userpass
username=YOUR_SIP_USER
password=YOUR_SIP_PASSWORD

[netgsm]
type=endpoint
transport=netgsm-udp
context=netgsm-incoming
disallow=all
allow=ulaw,alaw
aors=netgsm-aor
outbound_auth=netgsm-auth
direct_media=no
dtmf_mode=rfc4733
allow_transfer=no

[netgsm-aor]
type=aor
contact=sip:sip.example-pbx.com:5060

[openai-aor]
type=aor
contact=sip:sip.api.openai.com:5061\;transport=tls

[openai]
type=endpoint
transport=openai-tls
context=reject-incoming
disallow=all
allow=ulaw,alaw
aors=openai-aor
direct_media=no
dtmf_mode=rfc4733
